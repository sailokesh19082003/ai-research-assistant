# Copy this file to .env and fill in real values.

# Set this to enable real GPT-4o answers. If left blank, the app
# automatically falls back to a local offline "extractive" responder so it
# still runs end-to-end without any paid API key.
OPENAI_API_KEY=your_key_here

LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.0

VECTOR_DB_DIR=./data/vector_db
RAW_DOCS_DIR=./data/raw_documents
DATASET_DIR=./data/dataset
SQLITE_DB_PATH=./data/app.db

MODEL_PATH=./models/tf_classifier.h5
TOKENIZER_PATH=./models/tokenizer.pickle
LABELS_PATH=./models/labels.json

CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
